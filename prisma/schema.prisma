generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id         Int       @id @default(autoincrement())
  patientId  String    @unique
  firstName  String
  lastName   String?
  age        Int
  gender     String
  mobile     String
  address    String?
  bloodGroup String?
  aadhaar    String?
  occupation String?
  isActive   Boolean   @default(true)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  labOrders     LabOrder[]
  visits        OpdVisit[]
  ipdAdmissions IpdAdmission[]
  charges       IpdCharge[]
  payments      IpdPayment[]
}

model OpdVisit {
  id                      Int       @id @default(autoincrement())
  opdNo                   String    @unique
  patientId               Int
  doctor                  String
  department              String
  complaint               String?
  historyOfPresentIllness String?
  pastHistory             String?
  drugHistory             String?
  familyHistory           String?
  personalHistory         String?
  allergy                 String?
  examination             String?
  generalExamination      String?
  cvs                     String?
  rs                      String?
  cns                     String?
  pa                      String?
  localExamination        String?
  diagnosis               String?
  advice                  String?
  bp                      String?
  pulse                   Int?
  respiratoryRate         Int?
  temperature             Float?
  spo2                    Int?
  height                  Float?
  weight                  Float?
  bmi                     Float?
  randomBloodSugar        Float?
  painScore               Int?
  fee                     Float?
  paymentMode             String?
  followUpDate            DateTime?
  followUpFromId          Int?
  createdAt               DateTime  @default(now())

  patient      Patient       @relation(fields: [patientId], references: [id])
  prescription Prescription?
}

model Prescription {
  id             Int      @id @default(autoincrement())
  opdVisitId     Int      @unique
  notes          String?
  investigations String?
  createdAt      DateTime @default(now())

  opdVisit OpdVisit           @relation(fields: [opdVisitId], references: [id])
  items    PrescriptionItem[]
}

model PrescriptionItem {
  id             Int     @id @default(autoincrement())
  prescriptionId Int
  medicineName   String
  strength       String?
  dosage         String?
  frequency      String?
  duration       String?
  instruction    String?
  morning        Boolean @default(false)
  afternoon      Boolean @default(false)
  night          Boolean @default(false)
  beforeFood     Boolean @default(false)
  afterFood      Boolean @default(false)
  sos            Boolean @default(false)
  quantity       Int?
  route          String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model Medicine {
  id           Int      @id @default(autoincrement())
  medicineCode String   @unique
  genericName  String
  brandName    String?
  strength     String?
  dosageForm   String?
  route        String?
  manufacturer String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DiseaseTemplate {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  category       String?
  investigations String?
  advice         String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  medicines DiseaseTemplateMedicine[]
}

model DiseaseTemplateMedicine {
  id           Int     @id @default(autoincrement())
  templateId   Int
  medicineName String
  strength     String?
  dosage       String?
  frequency    String?
  duration     String?
  instruction  String?
  morning      Boolean @default(false)
  afternoon    Boolean @default(false)
  night        Boolean @default(false)
  beforeFood   Boolean @default(false)
  afterFood    Boolean @default(false)
  sos          Boolean @default(false)
  quantity     Int?
  route        String?

  template DiseaseTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model LabTest {
  id          Int      @id @default(autoincrement())
  testCode    String   @unique
  category    String
  testName    String
  shortName   String?
  specimen    String
  method      String?
  unit        String?
  normalRange String?
  price       Float
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems LabOrderItem[]
}

model LabOrder {
  id          Int       @id @default(autoincrement())
  orderNo     String    @unique
  patientId   Int
  referredBy  String?
  status      String    @default("Pending")
  collectedAt DateTime?
  reportedAt  DateTime?
  createdAt   DateTime  @default(now())

  patient Patient        @relation(fields: [patientId], references: [id])
  items   LabOrderItem[]
}

model LabOrderItem {
  id      Int     @id @default(autoincrement())
  orderId Int
  testId  Int
  result  String?
  remarks String?

  order LabOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test  LabTest  @relation(fields: [testId], references: [id])
}

model LabSampleCollection {
  id          Int      @id @default(autoincrement())
  date        DateTime
  patientName String
  testName    String
  cost        Float
  labName     String

  sstBarcode      String?
  edtaBarcode     String?
  fluorideBarcode String?
  urineBarcode    String?
  sputumBarcode   String?
}

model Ward {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beds Bed[]
}

model Bed {
  id        Int      @id @default(autoincrement())
  wardId    Int
  bedNumber String   @unique
  status    String   @default("Available")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ward       Ward           @relation(fields: [wardId], references: [id], onDelete: Cascade)
  admissions IpdAdmission[]

  @@index([wardId])
  @@index([status])
}

model IpdAdmission {
  id        Int    @id @default(autoincrement())
  ipdNo     String @unique
  patientId Int
  bedId     Int

  admittingDoctor      String
  department           String
  chiefComplaint       String?
  provisionalDiagnosis String?
  admissionNotes       String?

  admissionDate DateTime  @default(now())
  dischargeDate DateTime?

  status String @default("Admitted")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  bed     Bed     @relation(fields: [bedId], references: [id])

  clinicalNotes             IpdClinicalNote[]
  vitals                    IpdVital[]
  medicationOrders          IpdMedicationOrder[]
  medicationAdministrations IpdMedicationAdministration[]
  investigations            IpdInvestigation[]
  dischargeSummary          IpdDischargeSummary?
  ipdCharges                IpdCharge[]
  ipdPayments               IpdPayment[]

  @@index([patientId])
  @@index([bedId])
  @@index([status])
}

model IpdClinicalNote {
  id          Int      @id @default(autoincrement())
  admissionId Int
  noteType    String   @default("Progress")
  note        String
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admission IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([createdAt])
}

model IpdVital {
  id               Int      @id @default(autoincrement())
  admissionId      Int
  recordedAt       DateTime @default(now())
  bp               String?
  pulse            Int?
  respiratoryRate  Int?
  temperature      Float?
  spo2             Int?
  weight           Float?
  randomBloodSugar Float?
  painScore        Int?
  remarks          String?
  recordedBy       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  admission IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([recordedAt])
}

model IpdMedicationOrder {
  id           Int       @id @default(autoincrement())
  admissionId  Int
  medicineName String
  strength     String?
  dosage       String?
  frequency    String?
  route        String?
  duration     String?
  instruction  String?
  startDate    DateTime  @default(now())
  endDate      DateTime?
  status       String    @default("Active")
  orderedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  admission       IpdAdmission                  @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  administrations IpdMedicationAdministration[]

  @@index([admissionId])
  @@index([status])
  @@index([createdAt])
}

model IpdMedicationAdministration {
  id                Int       @id @default(autoincrement())
  admissionId       Int
  medicationOrderId Int
  scheduledAt       DateTime  @default(now())
  administeredAt    DateTime?
  status            String    @default("Given")
  doseGiven         String?
  remarks           String?
  administeredBy    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  admission       IpdAdmission       @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  medicationOrder IpdMedicationOrder @relation(fields: [medicationOrderId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([medicationOrderId])
  @@index([scheduledAt])
  @@index([status])
}

model IpdInvestigation {
  id          Int @id @default(autoincrement())
  admissionId Int

  testName String
  testCode String?
  category String?
  status   String  @default("Ordered")
  result   String?
  remarks  String?

  orderedBy  String?
  orderedAt  DateTime  @default(now())
  reportedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admission IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([status])
  @@index([orderedAt])
}

model IpdDischargeSummary {
  id          Int @id @default(autoincrement())
  admissionId Int @unique

  finalDiagnosis       String?
  history              String?
  examination          String?
  hospitalCourse       String?
  investigations       String?
  treatmentGiven       String?
  procedures           String?
  conditionAtDischarge String?
  dischargeAdvice      String?
  followUpAdvice       String?

  dischargedBy  String?
  dischargeDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admission IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([dischargeDate])
}

model IpdCharge {
  id          Int @id @default(autoincrement())
  admissionId Int

  category    String
  description String

  quantity  Float @default(1)
  unitPrice Float
  total     Float

  chargeDate DateTime @default(now())
  createdBy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admission IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  patient   Patient?     @relation(fields: [patientId], references: [id])
  patientId Int?

  @@index([admissionId])
  @@index([category])
  @@index([chargeDate])
}

model IpdPayment {
  id          Int @id @default(autoincrement())
  admissionId Int

  receiptNo   String  @unique
  amount      Float
  paymentMode String
  remarks     String?

  receivedBy String?
  paidAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admission IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  patient   Patient?     @relation(fields: [patientId], references: [id])
  patientId Int?

  @@index([admissionId])
  @@index([paidAt])
}

model HospitalSettings {
  id                 Int      @id @default(1)
  hospitalName       String
  tagline            String?
  address            String
  city               String?
  state              String?
  pincode            String?
  phone              String?
  email              String?
  website            String?
  doctorName         String
  qualification      String?
  registrationNo     String?
  logo               String?
  signature          String?
  prescriptionFooter String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Staff {
  id           Int       @id @default(autoincrement())
  staffCode    String    @unique
  name         String
  role         String
  mobile       String?
  address      String?
  joiningDate  DateTime?
  isActive     Boolean   @default(true)
  username     String?   @unique
  passwordHash String?
  loginEnabled Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  attendance Attendance[]
  sessions   StaffSession[]
}

model Attendance {
  id             Int       @id @default(autoincrement())
  staffId        Int
  attendanceDate String
  status         String
  checkIn        DateTime?
  checkOut       DateTime?
  remarks        String?

  checkInLatitude       Float?
  checkInLongitude      Float?
  checkInAccuracy       Float?
  checkInDistanceMeters Float?

  checkOutLatitude       Float?
  checkOutLongitude      Float?
  checkOutAccuracy       Float?
  checkOutDistanceMeters Float?

  locationVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, attendanceDate])
}

model StaffSession {
  id        Int      @id @default(autoincrement())
  staffId   Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([expiresAt])
}
